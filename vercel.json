{
  "version": 2,
  "git": { "deploymentEnabled": false },
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "pnpm install",
  "devCommand": "pnpm run dev",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "crons": [{ "path": "/api/cron", "schedule": "0 7 * * *" }]
}
